<Page x:Class="Lumpix.Emulated.PC.Pages.New_pass"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lumpix.Emulated.PC.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="New_pass">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Content="New Password" Grid.ColumnSpan="2" Grid.Column="1" Grid.Row="1" FontSize="32" FontFamily="Comic Sans MS" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Content="New Password:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1" Grid.Row="3" FontFamily="Comic Sans MC"/>
        <PasswordBox x:Name="NewPasswordTextBox" VerticalAlignment="Center" Grid.Column="2" Grid.Row="3" FontFamily="Comic Sans MC"/>
        <Label Content="Repeat New Password:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1" Grid.Row="4" FontFamily="Comic Sans MC"/>
        <PasswordBox x:Name="RepeatNewPasswordTextBox" VerticalAlignment="Center" Grid.Column="2" Grid.Row="4" FontFamily="Comic Sans MC"/>
        <Button Content="Confirm Password" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="5" FontFamily="Comic Sans MC" Click="Button_Click"/>
        <Label x:Name="Error" Content="Password's must be the same" Foreground="Red" Grid.Row="4" Grid.Column="2" VerticalAlignment="Bottom" Visibility="Hidden"/>
    </Grid>
</Page>
